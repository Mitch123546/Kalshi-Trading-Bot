# Public data works without credentials. Credentials are required for account data/orders.
# Production public data is used for realistic paper trading. This does not
# enable orders; live trading still requires all three independent gates.
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Safety defaults. Production orders need all three live switches plus --confirm-live.
KALSHI_MODE=paper
KALSHI_ALLOW_LIVE=false
KALSHI_MAX_ORDER_RISK_DOLLARS=2.00
KALSHI_MAX_DAILY_LOSS_DOLLARS=10.00
KALSHI_MAX_OPEN_RISK_DOLLARS=10.00
KALSHI_MIN_EDGE=0.08
KALSHI_MIN_SECONDS_TO_CLOSE=45
KALSHI_MAX_SECONDS_TO_CLOSE=480

KALSHI_DB_PATH=data/kalshi.db
KALSHI_MODEL_PATH=models/commodity_mlp.pt
KALSHI_POLL_SECONDS=1.0
